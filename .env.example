# Environment Variables (Optional)
# Copy this to .env if you need to customize

# API Base URL - leave empty/unset in production. Requests will go through
# nginx on the same origin, which proxies /api/ to the backend container.
# Only set this if your backend is hosted on a different domain.
# VITE_API_URL=

# Auto-refresh interval in milliseconds (default: 60000 = 60 seconds)
# VITE_REFRESH_INTERVAL=60000

# Enable debug mode
# VITE_DEBUG=false
