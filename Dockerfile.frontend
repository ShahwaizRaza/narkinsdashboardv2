# Stage 1: Build React app
FROM node:18-alpine AS build
WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm install

# Copy all source files
COPY . .

# Debug: prove what source Docker actually received
RUN grep -n "API_URL" src/hooks/useSalesData.js

# Build the app (uses .env.production automatically)
RUN npm run build

# Debug: prove what the build actually produced
RUN ls -la dist/assets/

# Stage 2: Serve with Nginx
FROM nginx:alpine

# openssl is used by docker-entrypoint.sh to generate the password file
RUN apk add --no-cache openssl

COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Entrypoint generates the password file from env vars at container startup
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
